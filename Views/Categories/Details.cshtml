@model DeffCategory
@{
    ViewData["Title"] = "Category Details";
}

<div class="page-header">
    <h2><i class="bi bi-eye"></i> Category Details</h2>
</div>

<div class="card">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Category Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Category Code</dt>
            <dd class="col-sm-8">@Model.Code</dd>
            <dt class="col-sm-4">Category Code Account ID</dt>
            <dd class="col-sm-8">@(ViewData["Account"] ?? "—")</dd>
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@(Model.Active ? "Active" : "Inactive")</dd>
        </dl>
        <a asp-action="Index" class="btn btn-secondary mt-3">Back to Categories</a>
    </div>
</div>
